# Copy to .env and fill what you need. Nothing here is required to start.

# The port to listen on. Render sets this itself; 8080 is the local default.
PORT=8080

# A shared key for the whole API. Unset (the default) leaves it open — which is
# how it runs locally. Set it on the host and every call needs ?key=... or an
# x-api-key header. This is the old, flat way in; the signed flow below is the
# one to use, and this keeps working for anything already written against it.
API_KEY=

# ---------------------------------------------------------------------------
# Auth: signed requests + short-lived tokens. Set these and the API stops being
# public. See the README section "Sirf app ko data mile".
# ---------------------------------------------------------------------------

# Signs the tokens this server hands out. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# The app's shared secret. It is only ever sent to POST /api/auth/token, where
# it signs (method, path, timestamp, nonce, body). Keep it out of this repo; put
# it in the host's environment and in the app's build config.
CLIENT_SECRET=

# The same thing, per client, as id:secret,id:secret — which is how a secret gets
# rotated: keep the old id and the new one both valid until no build uses the old.
# CLIENT_SECRETS=app:newsecret,app-1024:oldsecret
CLIENT_SECRETS=

# How long an access token lives, in seconds (default 900 = 15 minutes).
AUTH_TTL_SECONDS=

# How much clock drift a signed request may have, in seconds (default 300).
AUTH_CLOCK_SKEW_SECONDS=

# Requests per minute, per ip and per device (default 120).
RATE_LIMIT_PER_MINUTE=

# Vedu (time, token) pairs, as time:token,time:token. REQUIRED for Vedu
# playback: nothing is baked into the code, because a captured pair is in effect
# a credential — and this repository is public. Vedu gates its play endpoint per
# app build, so if /api/vedu/status reports playback: false while listing: true,
# the capture is from a build Vedu has retired. Paste one from the current build.
VEDU_AUTH_PAIRS=

# Where the key/value store keeps its file. Defaults to ./data/kv.json.
# On a host with an ephemeral disk this only lasts for the life of the instance,
# which is fine: the providers re-register themselves when it is gone.
KV_FILE=
